# Required
WINMCP_CONFIG=C:\DVB\mcp\windows-admin-mcp\config\servers.json
WINMCP_AUDIT_DIR=C:\DVB\mcp\windows-admin-mcp\logs\audit

# Local host identity (used to block reboot of Cursor machine)
WINMCP_LOCAL_HOSTNAME=
WINMCP_LOCAL_FQDN=

# Policy overrides (optional)
WINMCP_VERIFY_TLS=true
WINMCP_MAX_CONCURRENCY=2
WINMCP_DEFAULT_DRY_RUN=true
WINMCP_ALLOW_PARALLEL_REBOOT=false

# Credential references — NOT passwords
# WINMCP_SERVER_EXAMPLE_01_CREDENTIAL=WINMCP/SERVER-EXAMPLE-01
# WINMCP_SERVER_EXAMPLE_01_USER=EXAMPLE\svc-winadmin
# WINMCP_SERVER_EXAMPLE_01_PASSWORD=

# SecretManagement vault (optional)
# WINMCP_SECRET_VAULT=WindowsAdminMCP

# Transport defaults
WINMCP_WINRM_PORT=5986
WINMCP_SSH_PORT=22

# Audit
WINMCP_LOG_LEVEL=info
WINMCP_AUDIT_RETENTION_DAYS=30

# Integration tests (optional)
# WINMCP_PILOT_SERVER_NAME=SERVER-PILOT-01
# RUN_WINMCP_INTEGRATION=false
