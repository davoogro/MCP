# Credenciales Oracle FM (OSS) — rellenar localmente, nunca commitear
ORACLE_FM_USER=
ORACLE_FM_PASSWORD=
ORACLE_FM_HOST=192.0.2.204
ORACLE_FM_SERVICE=OSS

# Límites y timeouts
# MAX_ROWS = techo duro por RC; DEFAULT_ROWS = filas por RC si la llamada no indica max_rows
ORACLE_FM_MAX_ROWS=5000
ORACLE_FM_DEFAULT_ROWS=500
ORACLE_FM_QUERY_TIMEOUT_S=30
# Tope del JSON devuelto al cliente MCP (recorta filas y marca response_truncated)
ORACLE_FM_MAX_RESPONSE_CHARS=80000
# Tope por celda de texto/CLOB
ORACLE_FM_MAX_CELL_CHARS=4000

# Mitigación proxy rc8 (~11 s): trocea ventanas temporales en tramos de N días
# (0 = desactivado; default 3). Se aplica automáticamente a rc8 cuando la SQL
# contiene un rango sobre ALARM_TIME más ancho que ese tramo.
ORACLE_FM_RC8_CHUNK_DAYS=3

# Exportación (export_query): directorio base local
ORACLE_FM_EXPORT_DIR=C:\DVB\exports\oss
