{
  "_comment": "Fuente única para generate.py. Placeholders: {python}, {node}, {dir} (carpeta del MCP), {sep}.",
  "servers": {
    "sqlserver-readonly": {
      "folder": "sqlserver-readonly-mcp",
      "python_module": "sqlserver_readonly_mcp"
    },
    "sqlserver-readwrite": {
      "folder": "sqlserver-readwrite-mcp",
      "python_module": "sqlserver_readwrite_mcp"
    },
    "fabric-sql": {
      "folder": "fabric-sql-mcp",
      "python_module": "fabric_sql_mcp"
    },
    "fabric-admin": {
      "folder": "fabric-admin-mcp",
      "python_module": "fabric_admin_mcp"
    },
    "oracle-alarms-readonly": {
      "folder": "oracle-alarms-readonly-mcp",
      "python_module": "oracle_alarms_readonly_mcp"
    },
    "nifi-readonly": {
      "folder": "nifi-readonly-mcp",
      "python_module": "nifi_readonly_mcp"
    },
    "s3-readonly": {
      "folder": "s3-readonly-mcp",
      "python_module": "s3_readonly_mcp"
    },
    "windows-fileshare": {
      "folder": "windows-fileshare-mcp",
      "python_module": "windows_fileshare_mcp"
    },
    "linux-ssh-readonly": {
      "folder": "linux-ssh-readonly-mcp",
      "python_module": "linux_ssh_readonly_mcp"
    },
    "windows-ssh-admin": {
      "folder": "windows-ssh-admin-mcp",
      "python_module": "windows_ssh_admin_mcp"
    },
    "windows-winrm-fleet": {
      "folder": "windows-winrm-fleet-mcp",
      "python_module": "windows_winrm_fleet_mcp"
    },
    "windows-guarded-admin": {
      "folder": "windows-guarded-admin-mcp",
      "python_module": "windows_guarded_admin_mcp.server",
      "env": {
        "WSA_MCP_CONFIG_DIR": "{dir}{sep}config"
      }
    },
    "wsl": {
      "folder": "wsl-mcp",
      "python_module": "wsl_mcp"
    },
    "postgres-readonly": {
      "folder": "postgres-readonly-mcp",
      "node_script": "dist/src/index.js",
      "env": {
        "PG_MCP_CONFIG": "{dir}{sep}config{sep}databases.yaml"
      },
      "build": "npm install && npm run build"
    },
    "mariadb-readonly": {
      "folder": "mariadb-readonly-mcp",
      "node_script": "dist/src/index.js",
      "env": {
        "MARIADB_MCP_CONFIG": "{dir}{sep}config{sep}databases.yaml"
      },
      "build": "npm install && npm run build"
    },
    "windows-psremoting": {
      "folder": "windows-psremoting-mcp",
      "node_script": "dist/src/index.js",
      "env": {
        "WINMCP_CONFIG": "{dir}{sep}config{sep}servers.json",
        "WINMCP_AUDIT_DIR": "{dir}{sep}logs{sep}audit"
      },
      "build": "npm install && npm run build"
    },
    "gitlab-selfhosted": {
      "folder": "gitlab-selfhosted-mcp",
      "node_script": "scripts/launch.mjs",
      "build": "npm install"
    },
    "athena-quicksight": {
      "folder": "athena-quicksight-mcp",
      "python_script": "athena_mcp_server.py"
    },
    "redshift-readonly": {
      "folder": "redshift-readonly-mcp",
      "python_script": "redshift_mcp_server.py"
    },
    "notion": {
      "folder": "notion-mcp",
      "python_script": "notion_mcp_server.py",
      "_note": "lee .env desde el directorio de trabajo: pon NOTION_API_KEY en env o lanza desde su carpeta"
    },
    "office365": {
      "folder": "office365-mcp",
      "python_script": "office365_mcp_server.py"
    },
    "ssh-inventory": {
      "folder": "ssh-inventory-mcp",
      "node_script": "index.js",
      "build": "npm install"
    }
  }
}
