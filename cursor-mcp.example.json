{
  "mcpServers": {
    "fabric-sql": {
      "command": "C:\\DVB\\python\\python.exe",
      "args": ["C:\\DVB\\mcp\\fabric_mcp_server.py"],
      "env": {
        "FABRIC_SERVER": "your-workspace.datawarehouse.fabric.microsoft.com",
        "FABRIC_DATABASE": "master",
        "FABRIC_USER": "tu.correo@empresa.com",
        "FABRIC_PASSWORD": "tu_password"
      }
    },
    "fabric-sql-2": {
      "command": "C:\\DVB\\python\\python.exe",
      "args": ["C:\\DVB\\mcp\\fabric_mcp_server2.py"],
      "env": {
        "FABRIC2_SERVER": "otro-workspace.datawarehouse.fabric.microsoft.com",
        "FABRIC2_DATABASE": "master",
        "FABRIC2_USER": "tu.correo@empresa.com",
        "FABRIC2_PASSWORD": "tu_password"
      }
    },
    "postgres": {
      "command": "C:\\DVB\\python\\python.exe",
      "args": ["C:\\DVB\\mcp\\postgres_mcp_server.py"],
      "env": {
        "PG_USER": "postgres",
        "PG_PASSWORD": "tu_password_postgres",
        "PG_CONNECTIONS_FILE": "C:\\DVB\\mcp\\postgres_connections.json",
        "PG_READONLY": "true"
      }
    },
    "wsl": {
      "command": "C:\\DVB\\python\\python.exe",
      "args": ["-u", "C:\\DVB\\mcp\\wsl_mcp_server.py"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONIOENCODING": "utf-8",
        "WSL_DISTRO": "mynoble24.04",
        "WSL_DEFAULT_CWD": "/home"
      }
    },
    "multi-postgres": {
      "command": "node",
      "args": [
        "C:\\DVB\\mcp\\multi-postgres-mcp\\dist\\src\\index.js"
      ],
      "env": {
        "PG_MCP_CONFIG": "C:\\DVB\\mcp\\multi-postgres-mcp\\config\\databases.yaml"
      }
    },
    "windows-admin": {
      "command": "C:\\Users\\youruser\\AppData\\Local\\Programs\\cursor\\resources\\app\\resources\\helpers\\node.exe",
      "args": [
        "C:\\DVB\\mcp\\windows-admin-mcp\\dist\\src\\index.js"
      ],
      "env": {
        "WINMCP_CONFIG": "C:\\DVB\\mcp\\windows-admin-mcp\\config\\servers.json",
        "WINMCP_AUDIT_DIR": "C:\\DVB\\mcp\\windows-admin-mcp\\logs\\audit"
      }
    }
  }
}
