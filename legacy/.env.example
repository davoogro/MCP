# ============================================================
# Microsoft Fabric SQL — instancia principal (fabric_mcp_server.py)
# ============================================================
FABRIC_SERVER=your-workspace.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=master
FABRIC_USER=tu.correo@empresa.com
FABRIC_PASSWORD=tu_password_azure_ad
FABRIC_READONLY=true
FABRIC_QUERY_TIMEOUT=120
FABRIC_CACHE_TTL=0
FABRIC_POOL=true

# ============================================================
# Microsoft Fabric SQL — segunda instancia (fabric_mcp_server2.py)
# ============================================================
FABRIC2_SERVER=otro-workspace.datawarehouse.fabric.microsoft.com
FABRIC2_DATABASE=master
FABRIC2_USER=tu.correo@empresa.com
FABRIC2_PASSWORD=tu_password_azure_ad
FABRIC2_READONLY=true

# ============================================================
# PostgreSQL (postgres_mcp_server.py)
# ============================================================
PG_USER=postgres
PG_PASSWORD=tu_password_postgres
PG_CONNECTIONS_FILE=C:\DVB\mcp\postgres_connections.json
PG_READONLY=true
PG_QUERY_TIMEOUT=120
PG_SSLMODE=prefer

# ============================================================
# WSL (wsl_mcp_server.py)
# ============================================================
WSL_DISTRO=mynoble24.04
WSL_USER=
WSL_DEFAULT_CWD=/home
WSL_COMMAND_TIMEOUT=120
WSL_MAX_OUTPUT=100000
WSL_SHELL=/bin/bash
