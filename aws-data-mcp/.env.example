# Credenciales AWS (o déjalas vacías y usa la cadena por defecto de boto3: perfil / SSO / rol)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Athena
ATHENA_DATABASE=
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_S3=s3://my-athena-results/prefix/
ATHENA_QUERY_TIMEOUT=120

# QuickSight: archivo con credenciales de la cuenta QuickSight (default: ./quicksight.env)
QUICKSIGHT_ENV_FILE=

# Proxy corporativo con inspección TLS: genera el bundle con build_ca_bundle.py
AWS_CA_BUNDLE=
# AWS_DISABLE_SSL_VERIFY=1
LOG_LEVEL=INFO
