# Directorio de configuración YAML (opcional; por defecto ./config)
# NIFI_MCP_CONFIG_DIR=C:\DVB\mcp\nifi-readonly-mcp\config

# Credenciales SOLO en .env (nunca en YAML ni en este archivo de ejemplo).
# appsrv01 y nifisrv05: HTTPS + usuario/password.
NIFI_APPSRV01_USER=
NIFI_APPSRV01_PASSWORD=
# NIFI_APPSRV01_TOKEN=

# appsrv02 y appsrv03: HTTP :8080, SIN autenticación.
# No definir USER/PASSWORD/TOKEN para esos hosts.

NIFI_NIFISRV05_USER=
NIFI_NIFISRV05_PASSWORD=
# NIFI_NIFISRV05_TOKEN=

# Tope del JSON devuelto al cliente MCP (default 80000; recorta listas y marca response_truncated)
# NIFI_MCP_MAX_RESPONSE_CHARS=80000

# Pruebas de integración en vivo (solo lectura)
# NIFI_MCP_LIVE_TESTS=0
