REDSHIFT_CLUSTER_ID=my-cluster
REDSHIFT_DATABASE=dev
REDSHIFT_DB_USER=readonly_user
REDSHIFT_AWS_REGION=us-east-1

# Credenciales: elige una opción. Si no hay ninguna se usa la cadena por defecto de boto3.
REDSHIFT_AWS_ACCESS_KEY_ID=
REDSHIFT_AWS_SECRET_ACCESS_KEY=
REDSHIFT_AWS_SESSION_TOKEN=
# REDSHIFT_AWS_PROFILE=my-sso-profile
# REDSHIFT_CREDENTIALS_FILE=path/to/credentials.env
# Si se define, se rechazan credenciales de otra cuenta
# REDSHIFT_AWS_ACCOUNT_ID=123456789012

REDSHIFT_MAX_ROWS=1000
REDSHIFT_QUERY_TIMEOUT=300
AWS_CA_BUNDLE=
LOG_LEVEL=INFO
