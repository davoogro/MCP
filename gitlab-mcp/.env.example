# GitLab corporativo (self-hosted)
GITLAB_API_URL=https://gitlab.example.com/api/v4

# --- Opción A (recomendada para empezar): Personal Access Token ---
# Crear en GitLab: Avatar → Preferences → Access Tokens
# Scopes mínimos para lectura/escritura vía MCP: api
# GITLAB_PERSONAL_ACCESS_TOKEN=glpat-xxxxxxxx

# --- Opción B: OAuth2 (mejor con SAML/SSO en el navegador) ---
# 1) Crear OAuth Application en GitLab (Preferences → Applications)
# 2) Redirect URI: http://127.0.0.1:8888/callback  (solo para crear la app; device flow no lo usa)
# 3) Ejecutar una vez: scripts\auth-oauth.ps1
# GITLAB_USE_OAUTH=true
# GITLAB_OAUTH_CLIENT_ID=xxxxxxxx
# GITLAB_OAUTH_CLIENT_SECRET=          # solo si la app es "Confidential"
# GITLAB_OAUTH_REDIRECT_URI=http://127.0.0.1:8888/callback
# GITLAB_OAUTH_TOKEN_PATH=C:\Users\TU_USUARIO\.gitlab-mcp-token.json

# Permisos del MCP: readonly | modify (sin deletes) | full
GITLAB_PERMISSION_MODE=modify

# TLS corporativo (descomentar si falla certificado interno)
# GITLAB_CA_CERT_PATH=C:\DVB\mcp\gitlab-mcp\certs\gitlab-ca.pem
# NODE_TLS_REJECT_UNAUTHORIZED=0
