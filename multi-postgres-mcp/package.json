{
  "name": "multi-postgres-mcp",
  "version": "1.2.0",
  "description": "MCP server for managing and querying multiple PostgreSQL databases in read-only mode",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "multi-postgres-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-server.ts",
    "smoke": "node dist/scripts/stdio-smoke.js",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "postgresql",
    "model-context-protocol",
    "readonly"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "yaml": "^2.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
