# ------------------------------------------------------------------
# s3-mcp — si este archivo no existe se usa C:\DVB\mcp\.env
# Precedencia de credenciales: S3_* > access_key/secret_key > AWS_*
# El session token de AWS solo acompaña al par AWS_*.
# ------------------------------------------------------------------

# Par explícito (máxima precedencia)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=

# Nombres ya usados en el .env compartido de C:\DVB\mcp
# access_key=
# secret_key=

# Par estándar
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

S3_REGION=us-east-1
# S3_ENDPOINT_URL=http://127.0.0.1:9000

# Buckets conocidos (el IAM puede no tener s3:ListAllMyBuckets)
S3_BUCKETS=bucket-a,bucket-b
# S3_BUCKET_ALLOWLIST_ONLY=false
# S3_DEFAULT_BUCKET=bucket-a

# S3_MAX_SCAN_OBJECTS=200000
# S3_MAX_READ_BYTES=20971520
# S3_MAX_PARQUET_READ_BYTES=268435456
# S3_MAX_COUNT_BYTES=2147483648
# S3_QUERY_MAX_BYTES=2147483648
# S3_MAX_DOWNLOAD_BYTES=5368709120
# S3_MAX_QUERY_ROWS=5000
# S3_MAX_RESPONSE_CHARS=80000
# S3_MCP_ENV_FILE=C:\ruta\otro.env
