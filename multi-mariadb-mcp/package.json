{
  "name": "multi-mariadb-mcp",
  "version": "1.2.0",
  "description": "MCP server for managing and querying multiple MariaDB/MySQL databases in read-only mode",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "multi-mariadb-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-server.ts",
    "smoke": "node dist/scripts/stdio-smoke.js",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mariadb",
    "mysql",
    "model-context-protocol",
    "readonly"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "mysql2": "^3.14.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
