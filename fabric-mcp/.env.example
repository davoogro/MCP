# ------------------------------------------------------------------
# Fabric MCP — si este archivo no existe se usa C:\DVB\mcp\.env
# (el mismo que usaban fabric_mcp_server.py / fabric_mcp_server2.py).
# Cada prefijo FABRIC<n>_ es una conexión independiente.
# ------------------------------------------------------------------

# Conexión principal -> alias "default" (o el de FABRIC_NAME)
FABRIC_SERVER=xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=mi_warehouse
FABRIC_USER=tu.correo@empresa.com
FABRIC_PASSWORD=tu_password_entra_id
# FABRIC_NAME=prod
# FABRIC_AUTH=ActiveDirectoryPassword   # | ActiveDirectoryServicePrincipal | ActiveDirectoryInteractive | ActiveDirectoryIntegrated
# FABRIC_DRIVER=ODBC Driver 18 for SQL Server
FABRIC_READONLY=true
FABRIC_QUERY_TIMEOUT=120
FABRIC_CACHE_TTL=0
FABRIC_POOL=true

# Segunda conexión -> alias "fabric2"
# FABRIC2_SERVER=otro.datawarehouse.fabric.microsoft.com
# FABRIC2_DATABASE=otro_lakehouse
# FABRIC2_USER=tu.correo@empresa.com
# FABRIC2_PASSWORD=...
# FABRIC2_READONLY=true

# Globales
# FABRIC_MCP_DEFAULT=default          # alias por defecto cuando no se pasa `connection`
# FABRIC_MCP_MAX_CELL_CHARS=4000      # trunca celdas de texto largas en la respuesta (query: max 10000)
# FABRIC_MCP_MAX_ROWS=5000            # filas por página en query / fetch_more
# FABRIC_MCP_MAX_RESPONSE_CHARS=80000 # recorte JSON; el sobrante queda en rows_buffered
# FABRIC_MCP_CURSOR_MAX_ROWS=1000000  # tope de filas leídas por cursor abierto
# FABRIC_EXPORT_DIR=C:\DVB\exports\fabric
# FABRIC_EXPORT_MAX_ROWS=50000000
# FABRIC_MCP_ENV_FILE=C:\ruta\otro.env
