# Ruta al YAML de inventario (opcional; default config/servers.yaml en el proyecto)
# WINFLEET_CONFIG=C:\DVB\mcp\windows-winrm-fleet-mcp\config\servers.yaml

# Directorio de auditoría JSONL (default logs/ en el proyecto)
# WINFLEET_AUDIT_DIR=C:\DVB\mcp\windows-winrm-fleet-mcp\logs

# Workers PowerShell persistentes en paralelo (default 3)
# WINFLEET_WORKERS=3

# Ejecutable PowerShell 5.1 (default powershell.exe en PATH)
# WINFLEET_POWERSHELL=powershell.exe

# Tope de caracteres JSON por respuesta (default 100000)
# WINFLEET_MAX_RESPONSE_CHARS=100000
