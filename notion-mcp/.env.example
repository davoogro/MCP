# Notion MCP Server Configuration
# Copia este archivo a .env y rellena los valores

# API Key de Notion (obligatorio)
# Obtén una en: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de base de datos por defecto (opcional)
# Puedes obtenerlo de la URL de una base de datos de Notion
NOTION_DEFAULT_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de página por defecto (opcional)
NOTION_DEFAULT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configuración avanzada (opcional)
NOTION_TIMEOUT_SECONDS=30
NOTION_MAX_RESULTS=100